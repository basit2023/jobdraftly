# Copy these names into a protected service-level environment or secret manager.
# Never deploy this example with placeholder values.
NODE_ENV="production"
DATABASE_URL="mysql://jobdraftly_app:replace-me@127.0.0.1:3306/jobdraftly"
NEXTAUTH_SECRET="replace-with-at-least-32-random-bytes"
NEXTAUTH_URL="https://jobs-staging.jobdraftly.com"
NEXT_PUBLIC_SITE_URL="https://jobs-staging.jobdraftly.com"
CRON_SECRET="replace-with-a-distinct-32-byte-secret"

# Redis must use TLS when it is not on a private loopback interface.
REDIS_URL="rediss://default:replace-me@redis.example.invalid:6379"
REDIS_KEY_PREFIX="jobdraftly:staging"
WORKER_POLL_INTERVAL_MS="60000"
MONITOR_SOURCE_BATCH_SIZE="10"

# OpenAI structured extraction for newly discovered job adverts.
OPENAI_API_KEY=""
AI_EXTRACTION_MODEL="gpt-5.4-mini"
AI_AUTO_PUBLISH_MIN_CONFIDENCE="0.85"
AI_DEFAULT_LISTING_DAYS="30"
AI_PUBLISH_BATCH_SIZE="10"

# S3-compatible object storage for public company logos.
OBJECT_STORAGE_ENDPOINT="https://s3.example.invalid"
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_BUCKET="jobdraftly-staging-public"
OBJECT_STORAGE_ACCESS_KEY_ID="replace-me"
OBJECT_STORAGE_SECRET_ACCESS_KEY="replace-me"
OBJECT_STORAGE_PUBLIC_BASE_URL="https://assets-staging.jobdraftly.com"
OBJECT_STORAGE_FORCE_PATH_STYLE="false"

NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
AI_EXTRACTION_WEBHOOK_URL=""
AI_EXTRACTION_WEBHOOK_SECRET=""
APP_RELEASE=""

# Backup utilities. Keep this outside the application/release directory.
MYSQL_BIN_DIR="C:\\wamp64\\bin\\mysql\\mysql8.4.0\\bin"
BACKUP_DIRECTORY="E:\\JobDraftlyBackups"
BACKUP_RETENTION_DAYS="14"
BACKUP_FAILURE_WEBHOOK_URL=""
