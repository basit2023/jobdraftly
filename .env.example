# Copy to .env.local for local development. Never commit real credentials.
DATABASE_URL="mysql://jobdraftly_user:replace-me@127.0.0.1:3306/jobdraftly"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL="fastsitecheck@gmail.com"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_GTM_ID="GTM-WFDVNXZ4"
CRON_SECRET="replace-with-a-separate-long-random-secret"
MONITOR_SOURCE_BATCH_SIZE="10"

# Optional release identifier included by your hosting platform in logs/monitoring.
APP_RELEASE=""

# --- AI job posting (OpenAI) ---------------------------------------------
# Get a project key at https://platform.openai.com/api-keys. Without it, discovered
# adverts are stored but no jobs are created.
OPENAI_API_KEY=""
AI_EXTRACTION_MODEL="gpt-5.4-mini"
# Trusted sources (admin → Sources → "Trusted: auto-publish") publish a job
# automatically only at or above this confidence; otherwise it waits for review.
AI_AUTO_PUBLISH_MIN_CONFIDENCE="0.85"
# Jobs without a stated deadline are taken down after this many days.
AI_DEFAULT_LISTING_DAYS="30"
AI_PUBLISH_BATCH_SIZE="10"

# --- Scheduler (npm run worker / npm run worker:dev) -------------------------
WORKER_POLL_INTERVAL_MS="60000"
EXPIRY_INTERVAL_MINUTES="15"
# Required in production for the worker lease; optional locally.
REDIS_URL=""

# --- Email (SMTP) -----------------------------------------------------------
# Sends company login verification and password-reset emails.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com and an
# App Password (Google Account > Security > 2-Step Verification > App passwords),
# not your normal password. Without SMTP, development saves emails to
# storage/dev-outbox/ and production shows the link on screen instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="JobDraftly <fastsitecheck@gmail.com>"

# --- Company accounts and applications --------------------------------------
# Candidate CVs are private. By default they are saved under ./storage/private on
# the server (outside /public). Set PRIVATE_STORAGE_DIR to a backed-up folder, or
# PRIVATE_STORAGE_S3_BUCKET to a PRIVATE bucket (uses the OBJECT_STORAGE_* keys).
PRIVATE_STORAGE_DIR=""
PRIVATE_STORAGE_S3_BUCKET=""
# Applications and CVs are deleted automatically after this many days.
APPLICATION_RETENTION_DAYS="365"

# --- Images (Cloudinary) ---------------------------------------------------
# Either the single URL from the Cloudinary dashboard…
CLOUDINARY_URL=""
# …or the three separate values.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="jobdraftly"

# Optional adapter for an existing authorized OCR/AI extraction service.
# Both values are required before document extraction is attempted.
AI_EXTRACTION_WEBHOOK_URL=""
AI_EXTRACTION_WEBHOOK_SECRET=""

# Used only by `npm run admin:create`; never commit real values.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
