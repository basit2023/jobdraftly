# Copy to .env.local for local development. Never commit real credentials.
DATABASE_URL="mysql://jobdraftly_user:replace-me@127.0.0.1:3306/jobdraftly"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL="fastsitecheck@gmail.com"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
CRON_SECRET="replace-with-a-separate-long-random-secret"
MONITOR_SOURCE_BATCH_SIZE="10"

# Optional release identifier included by your hosting platform in logs/monitoring.
APP_RELEASE=""

# --- AI job posting (Claude) ---------------------------------------------
# Get a key at https://platform.claude.com → API keys. Without it, discovered
# adverts are stored but no jobs are created.
ANTHROPIC_API_KEY=""
AI_EXTRACTION_MODEL="claude-opus-5-5"
# Trusted sources (admin → Sources → "Trusted: auto-publish") publish a job
# automatically only at or above this confidence; otherwise it waits for review.
AI_AUTO_PUBLISH_MIN_CONFIDENCE="0.85"
# Jobs without a stated deadline are taken down after this many days.
AI_DEFAULT_LISTING_DAYS="30"
AI_PUBLISH_BATCH_SIZE="10"

# --- Scheduler (npm run worker / npm run worker:dev) -------------------------
WORKER_POLL_INTERVAL_MS="60000"
EXPIRY_INTERVAL_MINUTES="15"
# Required in production for the worker lease; optional locally.
REDIS_URL=""

# --- Images (Cloudinary) ---------------------------------------------------
# Either the single URL from the Cloudinary dashboard…
CLOUDINARY_URL=""
# …or the three separate values.
CLOUDINARY_CLOUD_NAME="jobdraftly12345678"
CLOUDINARY_API_KEY="152727942926875123456789"
CLOUDINARY_API_SECRET="zRFyNzundn1bVWac66rulRH4sYc12345678909876543567654"
CLOUDINARY_FOLDER="jobdraftly"

# Optional adapter for an existing authorized OCR/AI extraction service.
# Both values are required before document extraction is attempted.
AI_EXTRACTION_WEBHOOK_URL=""
AI_EXTRACTION_WEBHOOK_SECRET=""

# Used only by `npm run admin:create`; never commit real values.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

