{
  "name": "jobdraftly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --conditions=react-server --import tsx src/worker.ts",
    "worker:dev": "node --env-file=.env.local --conditions=react-server --import tsx src/worker.ts --dev",
    "jobs:run-once": "node --env-file=.env.local --conditions=react-server --import tsx scripts/run-jobs-once.ts",
    "prod:preflight": "node scripts/production-preflight.mjs",
    "backup:mysql": "node scripts/backup-mysql.mjs",
    "db:repair-local": "tsx scripts/repair-local-database.ts",
    "sample:seed": "tsx scripts/seed-sample-data.ts",
    "backup:test-restore": "node scripts/test-backup-restore.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reference-data": "tsx scripts/load-reference-data.ts",
    "db:studio": "prisma studio",
    "db:audit": "tsx scripts/audit-database.ts",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@aws-sdk/client-s3": "^3.1166.0",
    "@hookform/resolvers": "7.0.3",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "csv-parse": "7.0.3",
    "fast-xml-parser": "5.12.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "next-auth": "4.24.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "redis": "^6.3.1",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
